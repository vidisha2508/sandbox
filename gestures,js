export class GestureDetector{

constructor(){

this.currentGesture="OPEN";

this.previousPinch=false;

this.pinchThreshold=.045;
this.releaseThreshold=.065;

this.requiredFrames=3;

this.pinchFrames=0;
this.releaseFrames=0;

}

isUp(tip,pip){

return tip.y<pip.y;

}

update(hand){

if(!hand){

this.previousPinch=false;
this.currentGesture="NONE";
this.pinchFrames=0;
this.releaseFrames=0;

return this.currentGesture;

}

const thumb=hand[4];
const index=hand[8];

const dx=thumb.x-index.x;
const dy=thumb.y-index.y;

const distance=Math.sqrt(dx*dx+dy*dy);

let pinching=this.previousPinch;

if(!this.previousPinch){

if(distance<this.pinchThreshold){

pinching=true;

}

}else{

if(distance>this.releaseThreshold){

pinching=false;

}

}

if(pinching){

this.pinchFrames++;
this.releaseFrames=0;

}else{

this.releaseFrames++;
this.pinchFrames=0;

}

const indexUp=hand[8].y<hand[6].y;
const middleUp=hand[12].y<hand[10].y;

const ringDown=hand[16].y>hand[14].y-0.03;
const pinkyDown=hand[20].y>hand[18].y-0.03;

if(
indexUp &&
middleUp &&
ringDown &&
pinkyDown &&
!pinching
){
this.currentGesture="ROTATE";

return this.currentGesture;

}

if(
this.pinchFrames>=this.requiredFrames &&
!this.previousPinch
){

this.currentGesture="PINCH_START";
this.previousPinch=true;

}

else if(
this.previousPinch &&
pinching
){

this.currentGesture="PINCHING";

}

else if(
this.releaseFrames>=this.requiredFrames &&
this.previousPinch
){

this.currentGesture="RELEASE";
this.previousPinch=false;

}

else{

this.currentGesture="OPEN";

}

return this.currentGesture;

}

}
